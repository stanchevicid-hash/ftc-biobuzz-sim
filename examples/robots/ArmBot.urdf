<?xml version="1.0"?>
<!-- Test robot for the "Робот" tab: 4 mecanum wheels (continuous joints *_wheel) + one arm on a revolute joint.
     Geometry uses URDF primitives, so no mesh files are needed. Units: meters, X forward (URDF convention). -->
<robot name="ArmBot">
  <link name="base_link">
    <inertial><origin xyz="0 0 0.08"/><mass value="10.0"/><inertia ixx="0.2" iyy="0.2" izz="0.3" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.07"/><geometry><box size="0.40 0.32 0.06"/></geometry></visual>
    <visual><origin xyz="-0.12 0 0.16"/><geometry><box size="0.08 0.14 0.14"/></geometry></visual>
  </link>
  <link name="front_left_wheel"><inertial><mass value="0.25"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.048" length="0.038"/></geometry></visual></link>
  <link name="front_right_wheel"><inertial><mass value="0.25"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.048" length="0.038"/></geometry></visual></link>
  <link name="back_left_wheel"><inertial><mass value="0.25"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.048" length="0.038"/></geometry></visual></link>
  <link name="back_right_wheel"><inertial><mass value="0.25"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.048" length="0.038"/></geometry></visual></link>
  <joint name="fl_joint" type="continuous"><parent link="base_link"/><child link="front_left_wheel"/><origin xyz="0.14 0.18 0.048"/><axis xyz="0 1 0"/></joint>
  <joint name="fr_joint" type="continuous"><parent link="base_link"/><child link="front_right_wheel"/><origin xyz="0.14 -0.18 0.048"/><axis xyz="0 1 0"/></joint>
  <joint name="bl_joint" type="continuous"><parent link="base_link"/><child link="back_left_wheel"/><origin xyz="-0.14 0.18 0.048"/><axis xyz="0 1 0"/></joint>
  <joint name="br_joint" type="continuous"><parent link="base_link"/><child link="back_right_wheel"/><origin xyz="-0.14 -0.18 0.048"/><axis xyz="0 1 0"/></joint>
  <link name="arm">
    <inertial><origin xyz="0.12 0 0"/><mass value="0.6"/><inertia ixx="0.001" iyy="0.004" izz="0.004" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0.12 0 0"/><geometry><box size="0.26 0.04 0.03"/></geometry></visual>
  </link>
  <joint name="arm" type="revolute"><parent link="base_link"/><child link="arm"/><origin xyz="-0.12 0 0.24"/><axis xyz="0 -1 0"/>
    <limit lower="0" upper="2.4" effort="10" velocity="3"/></joint>
</robot>
